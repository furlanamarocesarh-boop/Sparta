# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Secrets — never commit. (Added with the Phase 2.5A baseline snapshot.)
# ---------------------------------------------------------------------------

# Service-account keys / Firebase Admin SDK credentials. These grant full,
# rule-bypassing access to the project — they are the crown jewels.
**/serviceAccount*.json
**/service-account*.json
**/*-firebase-adminsdk-*.json
**/adminsdk*.json
**/*credentials*.json

# Functions runtime config exports (may contain provider tokens / PIX secrets).
.runtimeconfig.json
**/.runtimeconfig.json

# Private keys and certificates.
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
*.cer
*.crt

# ---------------------------------------------------------------------------
# Firebase CLI cache and local emulator state
# ---------------------------------------------------------------------------
# NOTE: `.firebase/` is already ignored above. Emulator exports can contain
# real user records and wallet balances copied out of production — never commit.
emulator-data/
firebase-export-*/
**/firestore-debug.log
**/database-debug.log
**/pubsub-debug.log
**/ui-debug.log

# ---------------------------------------------------------------------------
# Editor / OS junk
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.orig
tmp/

# dataconnect generated files
.dataconnect
