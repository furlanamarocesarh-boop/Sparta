rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ADMIN AUTHORIZATION — custom claim ONLY.
    //
    // Authorization is the `admin: true` custom claim and nothing else. No UID,
    // email, or other identifier grants access. This is phase 2 of
    // docs/admin-transition.md: the transitional legacy-UID fallback has been
    // removed.
    //
    // `== true` is deliberate: a truthy value such as the string "true" or the
    // string "false" must never grant administrator access — the claim must be
    // exactly boolean true.
    function hasAdminClaim() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isAdmin() {
      return hasAdminClaim();
    }

    function isOwnerByUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerByUserRef() {
      return signedIn() && resource.data.user_ref == userRef();
    }

    // The DETERMINISTIC registration id that `jointournament` writes:
    // `{uid}_{tournamentId}`. This asks one narrow question — "is this document
    // path the caller's own?" — and is used ONLY to authorize the existence
    // check of a document that does NOT exist.
    //
    // It NEVER decides ownership of stored data. Whenever a registration
    // actually exists, authorization goes through the canonical stored
    // `user_ref` instead, so a malformed document whose id merely starts with
    // the caller's uid stays private.
    //
    // The prefix compared is `uid + '_'`, not `uid`, so prefix-similar uids
    // cannot reach each other: with uids "abc" and "abcdef", the id
    // "abcdef_t1" does not start with "abc_". Requiring the id to be strictly
    // LONGER than the prefix also rejects a bare "{uid}_" with no tournament.
    function isOwnDeterministicRegistrationId(registrationId) {
      let prefix = request.auth.uid + '_';
      return signedIn()
          && registrationId.size() > prefix.size()
          && registrationId[0:prefix.size()] == prefix;
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwnerByUid(userId) || isAdmin();

      // Por enquanto, bloqueia escrita direta.
      // onUserCreated e outras Cloud Functions continuam funcionando.
      allow create, update, delete: if false;
    }

    // WALLETS
    match /wallets/{userId} {
      // Usuário pode ler apenas a própria wallet.
      allow read: if isOwnerByUid(userId) || isAdmin();

      // Nunca permitir mexer em dinheiro direto pelo app.
      allow create, update, delete: if false;
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      // Usuário pode ler apenas transactions próprias.
      allow read: if isOwnerByUserRef() || isAdmin();

      // Transactions só podem ser criadas por Cloud Functions.
      allow create, update, delete: if false;
    }

    // WITHDRAWALS
    match /withdrawals/{withdrawalId} {
      // Usuário pode ler apenas saques próprios.
      allow read: if isOwnerByUserRef() || isAdmin();

      // Saques só podem ser criados/alterados por Cloud Functions.
      allow create, update, delete: if false;
    }

    // REGISTRATIONS
    //
    // `get` and `list` are authorized SEPARATELY, because they answer different
    // questions and only one of them needed to change.
    //
    // WHY: before rendering the join CTA, the app reads the deterministic
    // document `registrations/{uid}_{tournamentId}` to learn whether the player
    // is already registered. On a document that does NOT exist, `resource` is
    // null, so the old `resource.data.user_ref` check errored and denied the
    // read — the join button was never rendered and `jointournament` was never
    // invoked. A player who had never registered could never register at all.
    //
    // THE INVARIANT:
    //  - document EXISTS  -> ownership is decided ONLY by the canonical stored
    //    `user_ref`, exactly as before. The id is never trusted, so a malformed
    //    document whose id starts with the caller's uid is still private;
    //  - document MISSING -> the caller may probe ONLY their own deterministic
    //    path. This cannot leak anything: there is no document to read. It
    //    reveals exactly one bit, about the caller themselves — "am I
    //    registered for this tournament?" — which they are entitled to know.
    //
    // Each disjunct guards its own `resource` state, so `resource.data` is
    // never dereferenced on a missing document.
    match /registrations/{registrationId} {
      allow get: if isAdmin()
                 || (resource != null && isOwnerByUserRef())
                 || (resource == null
                     && isOwnDeterministicRegistrationId(registrationId));

      // Deliberately UNCHANGED and deliberately NOT sharing the `get` rule: a
      // query is always evaluated against existing documents, so the
      // missing-document exception must never apply to it. Listing stays
      // owner-filtered, and an unfiltered scan stays denied.
      allow list: if isAdmin() || isOwnerByUserRef();

      // Inscrição só via jointournament.
      allow create, update, delete: if false;
    }

    // TOURNAMENTS
    match /tournaments/{tournamentId} {
      // Todos logados podem ler torneios.
      allow read: if signedIn();

      // NENHUMA escrita direta de cliente, admin incluído. Bloquear apenas
      // `update` não basta: um admin-cliente poderia CRIAR um torneio já
      // `in_progress`, com `prize`/`result`/`status` arbitrário, contornando
      // completamente as callables. Todo torneio nasce e evolui somente via
      // Cloud Functions (Admin SDK, que ignora as Rules) — createTournament/
      // createtournament, jointournament, startTournament e
      // declareTournamentResult. Isso protege prize, entry_fee, status, result,
      // contagens de participantes e os campos de identidade/criação.
      allow create, update, delete: if false;
    }

    // TOURNAMENT ROOMS — credentials (room id + password).
    //
    // NEVER readable or writable by any client, admin included. The id/password
    // are sensitive: they are published ONLY by the setTournamentRoom callable
    // (Admin SDK, which bypasses rules) and handed to a registered player ONLY
    // by the getTournamentRoom callable. There is no direct client path.
    match /tournament_rooms/{tournamentId} {
      allow read, write: if false;
    }

    // PLAYER ACTIVITY — one document per player per business day, recording
    // that the player OPENED the app that day.
    //
    // NÃO é financeiro: não guarda valor, saldo, economia nem referência a
    // torneio. Mesmo assim segue exatamente a mesma postura das coleções
    // financeiras: leitura só do dono (ou admin) e NENHUMA escrita direta de
    // cliente. O documento nasce apenas pela callable recordDailyAppOpen
    // (Admin SDK, que ignora as Rules), então um jogador não consegue forjar
    // dias de acesso que nunca aconteceram, nem apagar os que aconteceram.
    //
    // O isolamento entre jogadores vem de isOwnerByUserRef(): tanto o `get`
    // direto quanto o `list` filtrado por user_ref só retornam documentos do
    // próprio usuário — um jogador nunca lê o histórico de outro.
    match /player_activity/{activityId} {
      allow read: if isOwnerByUserRef() || isAdmin();
      allow create, update, delete: if false;
    }

    // PUBLIC IDENTITY MAP — the UID -> publicPlayerId association, and its reverse
    // uniqueness guard. Server-only in BOTH directions: no client may read either,
    // so the pseudonym can never be resolved back to an account and the id space
    // cannot be enumerated; no client may write either, so an identity can never be
    // forged, reassigned or reused.
    //
    // `read: if false` applies to the ADMIN claim too. These documents are the one
    // bridge between a real account and its public pseudonym, so exposing them to
    // an admin client would defeat the pseudonymity for everyone at once. The
    // Admin SDK (Cloud Functions) bypasses Rules and remains the only writer.
    //
    // The catch-all below already denied both collections; stating the posture
    // explicitly is what makes it a decision instead of an inheritance.
    match /public_player_ids/{uid} {
      allow read, write: if false;
    }

    match /public_player_id_index/{publicPlayerId} {
      allow read, write: if false;
    }

    // PARTNER REFERRAL — the partner registry and the referral-code uniqueness
    // guard. Both are business records written exclusively by Cloud Functions.
    //
    // Admin MAY read, unlike the identity map above: these are commercial
    // records, not the bridge between an account and its pseudonym, and an
    // admin console has to list partners and their codes to manage them.
    //
    // NO player can read either. A partner's code set and status are not the
    // player's business, and `referral_codes` would otherwise be an enumeration
    // surface mapping every live code to its partner.
    //
    // Partner EARNINGS are protected elsewhere, and structurally: an accrual is
    // written into `transactions` WITHOUT a `user_ref`, so the rule above
    // (`isOwnerByUserRef() || isAdmin()`) resolves to admin-only for those rows
    // — a referred player cannot read what their activity earned the partner.
    //
    // What a player CAN see is their own `users/{uid}` document, which now
    // carries `partner_ref`, `attributed_at` and `attribution_expires_at`. That
    // is deliberate: the data subject can inspect the attribution recorded
    // about them.
    match /partners/{partnerId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /referral_codes/{code} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // CANDIDATURAS A PARCEIRO.
    //
    // O DONO LÊ A PRÓPRIA. O documento tem o uid como id, então a pessoa
    // acompanha o estado da sua candidatura sem conseguir listar as outras —
    // seguidores e audiência dos concorrentes não são da conta de ninguém.
    //
    // Admin lê todas: é quem avalia.
    //
    // NINGUÉM ESCREVE direto, dono incluído. Um candidato que pudesse escrever
    // aqui se aprovaria sozinho — `status` é o que `reviewPartnerApplication`
    // transforma em parceiro de verdade.
    match /partner_applications/{applicantUid} {
      allow get: if signedIn() && request.auth.uid == applicantUid
                 || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // CAIXA DA PLATAFORMA — o saldo que banca premiação acima da arrecadação.
    //
    // Admin LÊ: o painel do criador mostra o saldo, e sem leitura o número
    // teria de vir por uma callable só para contornar esta regra.
    //
    // NINGUÉM ESCREVE, admin incluído. O saldo só se move dentro da transação
    // de liquidação ou por `fundHouse`, ambas via Admin SDK, que ignora as
    // Rules. Um admin-cliente que pudesse escrever aqui poderia se dar caixa
    // infinito e, com ele, premiação infinita — que é exatamente a trava que
    // este documento existe para ser.
    //
    // Jogador não lê: quanto a casa tem não é da conta de quem joga.
    match /house/{economy} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // RANKING DE CRIADORES — volume por criador, por economia. Escrito
    // exclusivamente pelo gatilho de inscrição, servido exclusivamente pelo
    // callable, que projeta linha por linha.
    //
    // NINGUÉM LÊ DIRETO, nem admin. A entrada é chaveada pelo `creator_uid` e
    // guarda ele no documento: liberar leitura entregaria o uid de todo
    // criador junto com quanto cada um movimenta, que é exatamente o par que
    // o perfil público existe para não formar.
    match /creator_rankings/{economy} {
      allow read, write: if false;

      match /entries/{creatorUid} {
        allow read, write: if false;
      }
    }

    // RANKING DE CRIADORES POR TEMPORADA — a mesma coisa do quadro acumulado,
    // recortada por mês, e é dela que sai a colocação de um selo de temporada.
    // Fechada pelo mesmo motivo: a entrada guarda `creator_uid`, e liberar
    // leitura entregaria o uid de todo criador junto com quanto movimenta.
    match /creator_seasons/{seasonDoc} {
      allow read, write: if false;

      match /entries/{creatorUid} {
        allow read, write: if false;
      }
    }

    // RESULTADOS DE PARTIDA — lançados exclusivamente pelo callable de admin,
    // e lidos por qualquer jogador logado: a classificação de um campeonato é
    // pública para quem está nele, e esconder as partidas tornaria o placar
    // impossível de conferir.
    match /tournaments/{tournamentId}/matches/{matchNumber} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // CONFIGURAÇÕES SALVAS DE PONTUAÇÃO — a tabela de pontos e a divisão da
    // premiação que um criador guarda para reusar.
    //
    // NINGUÉM LÊ OU ESCREVE DIRETO, o próprio dono incluído. Não é sigilo: é
    // que a validação — pontos inteiros, posições sem buraco, percentuais que
    // somam exatamente 100% — mora no servidor, e uma escrita direta passaria
    // por fora dela. Uma configuração inválida não falha aqui; falha semanas
    // depois, no campeonato que ela configurou.
    //
    // Servido pelas callables saveScoringPreset / listScoringPresets /
    // deleteScoringPreset, que rodam pelo Admin SDK e ignoram as Rules, e cada
    // uma delas tira o uid do token verificado — nunca do payload.
    match /scoring_presets/{ownerUid} {
      allow read, write: if false;

      match /presets/{presetId} {
        allow read, write: if false;
      }
    }

    // CAIXA DE AVISOS — o dono LÊ, e ninguém escreve pelo cliente.
    //
    // A leitura é direta de propósito, em vez de passar por uma callable: é
    // isso que faz o aviso aparecer no instante em que ele é escrito, sem o
    // app ficar perguntando. Nada aqui é sigiloso — o aviso diz que a sala
    // abriu e NUNCA carrega o ID nem a senha, que continuam saindo só do
    // `getTournamentRoom`, que confere a inscrição antes de entregar.
    //
    // A escrita é server-only inclusive para o próprio dono: `read_at` é
    // marcado por `markNotificationsRead`. Deixar o cliente escrever aqui
    // permitiria fabricar um aviso na própria caixa, que é uma superfície sem
    // nenhuma utilidade.
    match /notifications/{ownerUid} {
      allow read: if isOwnerByUid(ownerUid);
      allow write: if false;

      match /items/{notificationId} {
        allow read: if isOwnerByUid(ownerUid);
        allow write: if false;
      }
    }

    // TOKENS DE APARELHO — fechados dos dois lados.
    //
    // Nem leitura: o documento liga um token de push a um uid, então poder
    // lê-lo daria a lista de aparelhos de uma conta. Servido por
    // registerDeviceToken / unregisterDeviceToken, que tiram o uid do token
    // verificado e nunca do payload.
    match /device_tokens/{token} {
      allow read, write: if false;
    }

    // CHAVEAMENTO DA COPA — quem enfrenta quem, e quem passou.
    //
    // LEGÍVEL POR QUEM ESTÁ LOGADO, pela mesma razão dos resultados de partida
    // logo acima: uma chave que o jogador não consegue ver é uma chave que ele
    // não consegue conferir, e o caminho até a final é a informação central de
    // um mata-mata.
    //
    // NINGUÉM ESCREVE. O sorteio e cada resultado passam por drawCupBracket e
    // declareCupMatch, que rodam pelo Admin SDK. Uma escrita direta aqui
    // promoveria alguém para uma chave que ele não disputou — e a premiação é
    // paga pela classificação que sai daqui.
    match /tournaments/{tournamentId}/bracket/{document} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Bloqueia qualquer collection não prevista.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}