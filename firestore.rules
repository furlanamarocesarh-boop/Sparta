rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ADMIN AUTHORIZATION — TRANSITIONAL.
    //
    // Accepts EITHER:
    //   1. the `admin` custom claim (the target state), OR
    //   2. the legacy hard-coded administrator UID (temporary compatibility).
    //
    // The UID fallback exists ONLY so the existing administrator is not locked
    // out the moment these rules are published. Removing it before the claim is
    // live would be an outage, not a hardening.
    //
    // REMOVE THE UID FALLBACK ONLY AFTER ALL THREE ARE TRUE
    // (full procedure in docs/admin-transition.md):
    //   1. the `admin: true` custom claim has been assigned to the administrator;
    //   2. that administrator's ID token has been REFRESHED — claims are baked
    //      into the token, so an un-refreshed token still lacks the claim;
    //   3. admin operations (testdeposit, payprize, tournament writes) have been
    //      verified working with the claim alone.
    //
    // `== true` is deliberate: a truthy value such as the string "false" must
    // never grant administrator access.
    function hasAdminClaim() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // COMPATIBILITY CONSTANT — TEMPORARY. Mirrors LEGACY_ADMIN_UID in
    // functions/src/domain/adminAuth.ts. Delete both together.
    function isLegacyAdmin() {
      return signedIn() && request.auth.uid == "Fnj4w17GGeP7XgQ5yF3gXTL1yR42";
    }

    function isAdmin() {
      return hasAdminClaim() || isLegacyAdmin();
    }

    function isOwnerByUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerByUserRef() {
      return signedIn() && resource.data.user_ref == userRef();
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwnerByUid(userId) || isAdmin();

      // Por enquanto, bloqueia escrita direta.
      // onUserCreated e outras Cloud Functions continuam funcionando.
      allow create, update, delete: if false;
    }

    // WALLETS
    match /wallets/{userId} {
      // Usuário pode ler apenas a própria wallet.
      allow read: if isOwnerByUid(userId) || isAdmin();

      // Nunca permitir mexer em dinheiro direto pelo app.
      allow create, update, delete: if false;
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      // Usuário pode ler apenas transactions próprias.
      allow read: if isOwnerByUserRef() || isAdmin();

      // Transactions só podem ser criadas por Cloud Functions.
      allow create, update, delete: if false;
    }

    // WITHDRAWALS
    match /withdrawals/{withdrawalId} {
      // Usuário pode ler apenas saques próprios.
      allow read: if isOwnerByUserRef() || isAdmin();

      // Saques só podem ser criados/alterados por Cloud Functions.
      allow create, update, delete: if false;
    }

    // REGISTRATIONS
    match /registrations/{registrationId} {
      // Usuário pode ler apenas inscrições próprias.
      allow read: if isOwnerByUserRef() || isAdmin();

      // Inscrição só via jointournament.
      allow create, update, delete: if false;
    }

    // TOURNAMENTS
    match /tournaments/{tournamentId} {
      // Todos logados podem ler torneios.
      allow read: if signedIn();

      // Só admin pode criar/editar/deletar torneios.
      allow create, update, delete: if isAdmin();
    }

    // Bloqueia qualquer collection não prevista.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}